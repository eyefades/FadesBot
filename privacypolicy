<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Privacy policy for FadesBot, including the information it processes, where it is stored, and how to request its deletion.">
  <meta name="theme-color" content="#f4f7f3">
  <title>Privacy Policy | FadesBot</title>
  <style>
    :root {
      color-scheme: light;
      --paper: #f4f7f3;
      --surface: #ffffff;
      --ink: #1b2925;
      --muted: #52635d;
      --line: #d8e1dc;
      --green: #185b48;
      --green-soft: #e4f0e9;
      --copper: #a44d32;
      --gold: #8a6417;
      --measure: 72rem;
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      background:
        linear-gradient(90deg, transparent 0, transparent calc(50% - 1px), rgba(24, 91, 72, .035) 50%, transparent calc(50% + 1px)),
        var(--paper);
      color: var(--ink);
      font-family: "Segoe UI", Tahoma, sans-serif;
      font-size: 16px;
      line-height: 1.7;
    }

    a { color: var(--green); text-underline-offset: 3px; }
    a:hover { color: var(--copper); }
    a:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }

    .skip-link {
      position: absolute;
      top: 8px;
      left: 8px;
      z-index: 2;
      padding: 10px 14px;
      transform: translateY(-150%);
      background: var(--ink);
      color: white;
    }

    .skip-link:focus { transform: translateY(0); }

    .masthead {
      border-bottom: 1px solid var(--line);
      background: rgba(255, 255, 255, .84);
    }

    .masthead-inner,
    .layout,
    .footer-inner {
      width: min(var(--measure), calc(100% - 48px));
      margin-inline: auto;
    }

    .masthead-inner {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .wordmark {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      color: var(--ink);
      font-size: 16px;
      font-weight: 700;
      text-decoration: none;
    }

    .mark {
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      border: 1px solid var(--green);
      color: var(--green);
      font-family: Georgia, serif;
      font-size: 18px;
      line-height: 1;
    }

    .masthead-label {
      color: var(--muted);
      font-size: 13px;
    }

    .layout {
      display: grid;
      grid-template-columns: 210px minmax(0, 1fr);
      gap: clamp(36px, 7vw, 96px);
      align-items: start;
      padding-block: 62px 88px;
    }

    .contents {
      position: sticky;
      top: 24px;
      padding-top: 8px;
    }

    .contents-title,
    .eyebrow,
    .section-kicker {
      color: var(--green);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .09em;
      text-transform: uppercase;
    }

    .contents-title { margin: 0 0 14px; }

    .contents ol {
      margin: 0;
      padding: 0;
      list-style: none;
      border-left: 1px solid var(--line);
    }

    .contents li { margin: 0; }

    .contents a {
      display: block;
      padding: 6px 0 6px 14px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.45;
      text-decoration: none;
    }

    .contents a:hover { color: var(--green); }

    main { min-width: 0; }

    .eyebrow { margin: 0 0 14px; }

    h1,
    h2,
    h3,
    p { margin-top: 0; }

    h1 {
      max-width: 13ch;
      margin-bottom: 18px;
      font-family: "Palatino Linotype", "Book Antiqua", Georgia, serif;
      font-size: 48px;
      font-weight: 500;
      line-height: 1.08;
    }

    .lede {
      max-width: 62ch;
      margin-bottom: 24px;
      color: var(--muted);
      font-size: 18px;
      line-height: 1.6;
    }

    .updated {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 40px;
      color: var(--muted);
      font-size: 13px;
    }

    .updated::before {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--green);
      content: "";
    }

    .notice {
      margin: 0 0 42px;
      padding: 18px 20px;
      border-left: 3px solid var(--copper);
      background: #fffaf5;
      color: #54392f;
    }

    .notice strong { color: #3a2922; }

    section {
      padding-block: 30px;
      border-top: 1px solid var(--line);
      scroll-margin-top: 22px;
    }

    .section-kicker { margin-bottom: 7px; }

    h2 {
      margin-bottom: 16px;
      font-family: "Palatino Linotype", "Book Antiqua", Georgia, serif;
      font-size: 27px;
      font-weight: 500;
      line-height: 1.2;
    }

    h3 {
      margin-bottom: 5px;
      font-size: 16px;
      font-weight: 700;
    }

    p, li { max-width: 72ch; }
    p { margin-bottom: 14px; }
    ul { padding-left: 22px; }
    li { margin-bottom: 8px; padding-left: 3px; }

    .data-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px 32px;
      margin: 22px 0 0;
    }

    .data-list > div { padding-top: 13px; border-top: 2px solid var(--green-soft); }
    .data-list p { margin-bottom: 0; color: var(--muted); font-size: 14px; }

    .contact-line {
      padding: 16px 18px;
      background: var(--green-soft);
    }

    .contact-line p { margin: 0; }

    footer {
      border-top: 1px solid var(--line);
      background: #eaf0eb;
    }

    .footer-inner {
      display: flex;
      justify-content: space-between;
      gap: 24px;
      padding-block: 24px;
      color: var(--muted);
      font-size: 13px;
    }

    .footer-inner p { margin: 0; }

    @media (max-width: 760px) {
      .masthead-inner,
      .layout,
      .footer-inner { width: min(100% - 36px, 620px); }

      .masthead-inner { min-height: 66px; }
      .masthead-label { font-size: 12px; }

      .layout {
        grid-template-columns: 1fr;
        gap: 28px;
        padding-block: 38px 64px;
      }

      .contents { position: static; }
      .contents ol { display: flex; flex-wrap: wrap; gap: 4px 14px; border: 0; }
      .contents a { padding: 4px 0; }
      h1 { font-size: 40px; }
      .lede { font-size: 17px; }
    }

    @media (max-width: 480px) {
      .masthead-inner,
      .layout,
      .footer-inner { width: min(100% - 28px, 620px); }

      .masthead-label { max-width: 132px; text-align: right; }
      h1 { font-size: 36px; }
      .data-list { grid-template-columns: 1fr; gap: 16px; }
      .footer-inner { flex-direction: column; gap: 8px; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
    }
  </style>
